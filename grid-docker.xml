<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Grid-Docker-Tests">
  <listeners>
  	<listener class-name="org.opencart.utilities.ExtentReportManager"/>
  </listeners>
  <test name="Linux-Chrome">
  <parameter name="browser" value="chrome"/>
  <parameter name="os" value="Linux"/>
    <classes>
      <class name="org.opencart.testcases.TC001_RegistrationTest"/>
      <class name="org.opencart.testcases.TC002_LoginTest"/>
    </classes>
  </test> <!-- Test -->
  
  <test name="Linux-Edge">
  <parameter name="browser" value="edge"/>
  <parameter name="os" value="Linux"/>
    <classes>
      <class name="org.opencart.testcases.TC001_RegistrationTest"/>
      <class name="org.opencart.testcases.TC002_LoginTest"/>
    </classes>
  </test> <!-- Test -->
  
  <test name="Linux-Firefox">
  <parameter name="browser" value="firefox"/>
  <parameter name="os" value="Linux"/>
    <classes>
      <class name="org.opencart.testcases.TC001_RegistrationTest"/>
      <class name="org.opencart.testcases.TC002_LoginTest"/>
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
